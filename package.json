{
  "name": "memhub",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "memhub": "./dist/mcp.js",
    "memhub-mcp": "./dist/mcp.js",
    "memhub-bridge": "./dist/bridge.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/core-e2e.mjs && node tests/mcp-e2e.mjs && node tests/openai-adapter-e2e.mjs && node tests/vendor-regressions.mjs && node tests/edition-regressions.mjs",
    "core:check": "node scripts/core-migration.mjs check",
    "core:preflight": "node scripts/core-migration.mjs preflight",
    "core:verify": "node scripts/core-migration.mjs verify",
    "core:preserved": "node scripts/core-migration.mjs preserved",
    "memory:audit": "node scripts/long-term-repair.mjs",
    "memory:repair": "node scripts/long-term-repair.mjs --apply",
    "state:audit": "node scripts/state-hygiene.mjs",
    "state:tidy": "node scripts/state-hygiene.mjs --apply",
    "release:check": "node scripts/package-all-release.mjs --check",
    "release:package": "node scripts/package-all-release.mjs",
    "release:quick:check": "node scripts/package-release.mjs --check",
    "release:quick:package": "node scripts/package-release.mjs",
    "release:complete:check": "node scripts/package-complete-release.mjs --check",
    "release:complete:package": "node scripts/package-complete-release.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^12.6.3",
    "dotenv": "^16.6.1",
    "fast-xml-parser": "^5.8.0",
    "fzstd": "^0.1.1",
    "ignore": "^7.0.5",
    "jose": "^6.2.12",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.8.0",
    "sqlite-vec": "0.1.9",
    "tiktoken": "^1.0.22",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.9.1"
  }
}
